# ==============================================================================
# HelpDesk Lite - Git Attributes Configuration (.gitattributes)
# Enforces consistent LF line endings across Windows, macOS, and Linux
# ==============================================================================

# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit source code and script types
*.py text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Configuration and markup files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env* text eol=lf

# Docker and CI
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary

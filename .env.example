# ==============================================================================
# HelpDesk Lite - Environment Variables Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env':
#      PowerShell: Copy-Item .env.example .env
#      Bash:       cp .env.example .env
# 2. Fill in your real API keys and credentials in '.env'.
# 3. DO NOT commit the '.env' file into version control (ignored via .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector (Checkpointer, Tickets, Policy Semantic Search)
# Matches service configuration in docker-compose.yml
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=helpdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# ------------------------------------------------------------------------------
# Neo4j Graph Database (Employees, Teams, Services, Outage Dependencies)
# Browser UI available at: http://localhost:7474
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ------------------------------------------------------------------------------
# Azure OpenAI (Primary LLM & Embedding Models)
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

AZURE_EMBEDDING_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_EMBEDDING_API_KEY=your_azure_embedding_api_key_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ------------------------------------------------------------------------------
# OpenAI Fallback (Optional, if not using Azure OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# LangSmith Observability, Tracing & Evaluation Suite
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com #auto doulevei
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=helpdesk-lite
